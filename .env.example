# ==============================================================================
# Internship Intelligence Assistant — Environment Configuration
# ==============================================================================

# Google Gemini AI API Key (Required for LLM and Embeddings)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
# Options: gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL=gemini-1.5-flash

# Embedding Model & Provider Configuration
# Provider Options: local (CPU ONNX all-MiniLM-L6-v2), gemini (Google Generative AI)
# Note: EMBEDDING_PROVIDER=local requires internet access on first use to download
# the FastEmbed model (~90MB, sentence-transformers/all-MiniLM-L6-v2), which is cached
# locally afterward for offline execution.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=models/text-embedding-004

# Local Storage & Vector Database Paths
CHROMA_PERSIST_DIRECTORY=data/chroma
UPLOAD_DIRECTORY=data/uploads
MAX_FILE_SIZE_MB=15

# Application Settings
DEBUG=false
